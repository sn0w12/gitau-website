{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "eslint/complexity": "warn"
    },
    "env": {
        "builtin": true,
        "browser": true
    },
    "ignorePatterns": ["package-lock.json", "dist", ".astro"]
}
