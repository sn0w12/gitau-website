---
import { getTextColor } from "../../lib/text-color";
import Badge from "../ui/Badge.astro";

interface Props {
    name: string;
    color: string;
}

const { name, color } = Astro.props;

const classes =
    getTextColor(color) === "bright" ? "text-light" : "text-dark";
---

<Badge class={classes} style={`background-color: #${color}`}>{name}</Badge>
