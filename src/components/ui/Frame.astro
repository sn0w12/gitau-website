---
import { cn } from "../../lib/cn";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;

const classes = cn(
    "relative flex flex-col rounded-2xl bg-muted/72 p-1",
    "*:[[data-slot=frame-panel]+[data-slot=frame-panel]]:mt-1",
    className
);
---

<div class={classes} data-slot="frame">
    <slot />
</div>
