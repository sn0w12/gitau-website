---
import { cn } from "../../lib/cn";

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<span
    class={cn(
        "flex size-full items-center justify-center rounded-full bg-muted",
        className
    )}
    data-slot="avatar-fallback"
>
    <slot />
</span>
