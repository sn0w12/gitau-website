---
import { cn } from "../../lib/cn";

interface Props {
    checked?: boolean;
    indeterminate?: boolean;
    disabled?: boolean;
    class?: string;
    "aria-label"?: string;
}

const {
    checked = false,
    indeterminate = false,
    disabled = false,
    class: className,
    "aria-label": ariaLabel,
} = Astro.props;

/* A span rather than the app's button: on the site every checkbox lives
 * inside a decorative mock, so it must not be focusable. The classes and the
 * state attributes match the app's root so the visuals line up. */
const classes = cn(
    "relative inline-flex size-4.5 shrink-0 items-center justify-center rounded-[.25rem] border border-input bg-background shadow-xs/5 ring-ring transition-shadow outline-none not-dark:bg-clip-padding before:pointer-events-none before:absolute before:inset-0 before:rounded-[3px] not-data-disabled:not-data-checked:not-aria-invalid:before:shadow-[0_1px_--theme(--color-black/4%)] focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:ring-offset-background aria-invalid:border-destructive/36 focus-visible:aria-invalid:border-destructive/64 focus-visible:aria-invalid:ring-destructive/48 sm:size-4 dark:not-data-checked:bg-input/32 dark:not-data-disabled:not-data-checked:not-aria-invalid:before:shadow-[0_-1px_--theme(--color-white/6%)] dark:aria-invalid:ring-destructive/24 data-disabled:cursor-not-allowed data-disabled:opacity-64 [[data-disabled],[data-checked],[aria-invalid]]:shadow-none",
    className
);

const state = disabled
    ? { "data-disabled": "" }
    : indeterminate
      ? { "data-indeterminate": "" }
      : checked
        ? { "data-checked": "" }
        : { "data-unchecked": "" };
---

<span
    class={classes}
    aria-label={ariaLabel}
    data-slot="checkbox"
    {...state}
>
    <span
        class="absolute -inset-px flex items-center justify-center rounded-[.25rem] text-primary-foreground data-indeterminate:text-foreground data-checked:bg-primary data-unchecked:hidden"
        data-slot="checkbox-indicator"
        {...state}
    >
        {
            indeterminate ? (
                <svg
                    aria-hidden="true"
                    class="size-3.5 sm:size-3"
                    fill="none"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    viewBox="0 0 24 24"
                    width="24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path d="M5.252 12h13.496" />
                </svg>
            ) : (
                <svg
                    aria-hidden="true"
                    class="size-3.5 sm:size-3"
                    fill="none"
                    height="24"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    viewBox="0 0 24 24"
                    width="24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path d="M5.252 12.7 10.2 18.63 18.748 5.37" />
                </svg>
            )
        }
    </span>
</span>
