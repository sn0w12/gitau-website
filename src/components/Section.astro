---
import { cn } from "../lib/cn";

interface Props {
    id?: string;
    class?: string;
    title?: string;
    description?: string;
    align?: "start" | "center";
}

const { id, class: className, title, description, align = "center" } =
    Astro.props;
---

<section id={id} class={cn("py-12 sm:py-18", className)}>
    <div class="shell">
        {
            (title || description) && (
                <div
                    class={cn(
                        "flex flex-col",
                        align === "center"
                            ? "mx-auto max-w-2xl items-center text-center"
                            : "max-w-2xl"
                    )}
                >
                    {title && (
                        <h2 class="font-display text-4xl tracking-tight text-balance sm:text-5xl">
                            {title}
                        </h2>
                    )}
                    {description && (
                        <p class="mt-4 text-lg text-muted-foreground text-pretty">
                            {description}
                        </p>
                    )}
                </div>
            )
        }
        <slot />
    </div>
</section>
