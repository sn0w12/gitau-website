---
import { Download, ExternalLink, Menu } from "lucide-astro";

import { cn } from "../lib/cn";
import { REPO_URL } from "../lib/site";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Button from "./ui/Button.astro";

interface NavLink {
    href: string;
    label: string;
    external?: boolean;
}

const links: NavLink[] = [
    { href: "/download", label: "Download" },
    { href: REPO_URL, label: "GitHub", external: true },
];

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
    if (href.includes("#") || !href.startsWith("/")) return false;
    return pathname === href || pathname.startsWith(`${href}/`);
}

const linkClass =
    "inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground";
---

<header
    data-site-header
    class="sticky top-0 z-50 border-b border-border/70 bg-background/80 backdrop-blur-md"
>
    <div class="shell flex h-16 items-center gap-6">
        <a
            href="/"
            class="flex items-center rounded-md outline-none focus-visible:ring-2 focus-visible:ring-ring"
            aria-label="gitau home"
        >
            <Logo />
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class={cn(
                            linkClass,
                            isActive(link.href) && "text-foreground"
                        )}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noreferrer noopener" : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>

        <div class="ml-auto flex items-center gap-1.5">
            <ThemeToggle />
            <span class="ml-1 hidden sm:block">
                <Button href="/download" size="sm">Download</Button>
            </span>
            <button
                id="nav-toggle"
                type="button"
                class="inline-flex size-9 items-center justify-center rounded-lg text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring md:hidden"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="nav-menu"
            >
                <Menu class="size-5" />
            </button>
        </div>
    </div>

    <div id="nav-menu" class="hidden border-t border-border/70 md:hidden">
        <nav class="shell flex flex-col py-3" aria-label="Mobile">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="rounded-md px-2 py-3 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noreferrer noopener" : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
            <span class="mt-3">
                <Button href="/download" class="w-full">
                    <Download class="size-4" />
                    Download gitau
                </Button>
            </span>
        </nav>
    </div>
</header>

<script>
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");

    if (toggle && menu) {
        toggle.addEventListener("click", () => {
            const hidden = menu.classList.toggle("hidden");
            toggle.setAttribute("aria-expanded", hidden ? "false" : "true");
        });

        for (const link of menu.querySelectorAll("a")) {
            link.addEventListener("click", () => {
                menu.classList.add("hidden");
                toggle.setAttribute("aria-expanded", "false");
            });
        }
    }
</script>
