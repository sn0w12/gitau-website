---
import { Download, ExternalLink, Menu, X } from "lucide-astro";

import { cn } from "../lib/cn";
import { REPO_URL } from "../lib/site";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Button from "./ui/Button.astro";

interface NavLink {
    href: string;
    label: string;
    external?: boolean;
}

const links: NavLink[] = [
    { href: "/download", label: "Download" },
    { href: REPO_URL, label: "GitHub", external: true },
];

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
    if (href.includes("#") || !href.startsWith("/")) return false;
    return pathname === href || pathname.startsWith(`${href}/`);
}

const linkClass =
    "inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground";
---

<header
    data-site-header
    class="sticky top-0 z-50 border-b border-border/70 bg-background/80 backdrop-blur-md"
>
    <div class="shell flex h-16 items-center gap-6">
        <a
            href="/"
            class="flex items-center rounded-md outline-none focus-visible:ring-2 focus-visible:ring-ring"
            aria-label="gitau home"
        >
            <Logo />
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class={cn(
                            linkClass,
                            isActive(link.href) && "text-foreground"
                        )}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noreferrer noopener" : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>

        <div class="ml-auto flex items-center gap-1.5">
            <ThemeToggle />
            <button
                id="nav-toggle"
                type="button"
                data-open="false"
                class="inline-flex size-9 items-center justify-center rounded-lg text-muted-foreground outline-none transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring md:hidden"
                aria-label="Open menu"
                aria-expanded="false"
                aria-controls="nav-menu"
            >
                <span class="grid size-5 place-items-center">
                    <span data-nav-icon="menu" class="col-start-1 row-start-1">
                        <Menu class="size-5" />
                    </span>
                    <span data-nav-icon="close" class="col-start-1 row-start-1">
                        <X class="size-5" />
                    </span>
                </span>
            </button>
        </div>
    </div>

    <div
        id="nav-menu"
        data-open="false"
        class="fixed top-16 w-full border-t border-border/70 bg-background md:hidden"
    >
        <nav class="shell flex flex-col py-3" aria-label="Mobile">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class="rounded-md px-2 py-3 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noreferrer noopener" : undefined}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
    </div>
</header>

<style>
    /* The panel drops out of the header, so it enters from just above and fades.
     * `visibility` hides it rather than `display`, which keeps the menu out of
     * the tab order and the accessibility tree while still letting both the
     * enter and the exit transition. Tailwind's `md:hidden` still removes it on
     * desktop, where the inline nav takes over. */
    #nav-menu {
        --menu-shift: -0.5rem;

        visibility: hidden;
        opacity: 0;
        transform: translateY(var(--menu-shift));
        transition:
            opacity 200ms var(--ease-snappy),
            transform 200ms var(--ease-snappy),
            visibility 0s linear 200ms;
    }

    #nav-menu[data-open="true"] {
        visibility: visible;
        opacity: 1;
        transform: none;
        transition:
            opacity 200ms var(--ease-snappy),
            transform 200ms var(--ease-snappy),
            visibility 0s;
    }

    /* The toggle morphs between the menu and close glyphs instead of swapping
     * hard, so the button reports the state it just changed. */
    #nav-toggle [data-nav-icon] {
        transition:
            opacity 160ms var(--ease-snappy),
            transform 160ms var(--ease-snappy);
    }

    #nav-toggle [data-nav-icon="close"] {
        opacity: 0;
        transform: rotate(-45deg) scale(0.8);
    }

    #nav-toggle[data-open="true"] [data-nav-icon="menu"] {
        opacity: 0;
        transform: rotate(45deg) scale(0.8);
    }

    #nav-toggle[data-open="true"] [data-nav-icon="close"] {
        opacity: 1;
        transform: none;
    }

    /* Reduced motion keeps the cross-fade that marks the state change and drops
     * the movement. */
    @media (prefers-reduced-motion: reduce) {
        #nav-menu {
            --menu-shift: 0rem;
            transition:
                opacity 150ms ease,
                visibility 0s linear 150ms;
        }

        #nav-menu[data-open="true"] {
            transition:
                opacity 150ms ease,
                visibility 0s;
        }

        #nav-toggle [data-nav-icon] {
            transition: opacity 150ms ease;
        }

        #nav-toggle [data-nav-icon="close"],
        #nav-toggle[data-open="true"] [data-nav-icon="menu"] {
            transform: none;
        }
    }
</style>

<script>
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("nav-menu");

    if (toggle && menu) {
        const setOpen = (open: boolean): void => {
            const value = open ? "true" : "false";
            menu.dataset.open = value;
            toggle.dataset.open = value;
            toggle.setAttribute("aria-expanded", value);
            toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        };

        toggle.addEventListener("click", () => {
            setOpen(menu.dataset.open !== "true");
        });

        for (const link of menu.querySelectorAll("a")) {
            link.addEventListener("click", () => setOpen(false));
        }
    }
</script>
