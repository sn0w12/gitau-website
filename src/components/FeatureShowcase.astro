---

<section id="features" class="pb-8 sm:pb-12">
    <div class="shell">
        <div
            data-reveal
            class="mx-auto flex max-w-2xl flex-col items-center text-center"
        >
            <h2
                class="font-display text-4xl tracking-tight text-balance sm:text-5xl"
            >
                A look around
            </h2>
        </div>

        <div class="mt-3 border-t border-border/70 border-dashed"></div>

        <div data-reveal-grid class="mt-8 grid gap-10 lg:grid-cols-3 lg:gap-6">
            <ShowcaseItem
                class="lg:col-span-2"
                title="Commit graph"
                description="Read history as a graph: branches, tags, and merges beside the commits that moved them."
            >
                <Frame class="flex-1">
                    <FramePanel class="flex-1 p-2">
                        <CommitGraph rows={commits} />
                    </FramePanel>
                </Frame>
            </ShowcaseItem>

            <ShowcaseItem
                title="Changes and commits"
                description="Stage files one at a time or all at once, then commit without leaving the list."
            >
                <ChangesPanel
                    branch="master"
                    filter=""
                    staged={[
                        {
                            kind: "modified",
                            path: "src/lib/diff.ts",
                            checked: true,
                        },
                    ]}
                    unstaged={[
                        {
                            kind: "added",
                            path: "src/components/stash-menu.tsx",
                        },
                        {
                            kind: "deleted",
                            path: "src/routes/legacy-page.tsx",
                        },
                        { kind: "modified", path: "src/lib/graph.ts" },
                    ]}
                />
            </ShowcaseItem>

            <ShowcaseItem
                title="Pull requests"
                description="Review threads, checks, and labels in the app. Comment on a line without a browser."
            >
                <GithubPanel
                    title="Pull Requests"
                    description="GitHub pull requests involving you, sorted by most recently updated."
                    refreshLabel="Refresh pull requests"
                    rows={pulls}
                    Row={PullRow}
                />
            </ShowcaseItem>

            <ShowcaseItem
                title="Issues"
                description="Filter by label, follow a thread through its comments, and render Markdown and Mermaid."
            >
                <GithubPanel
                    title="Issues"
                    description="GitHub issues involving you, sorted by most recently updated."
                    refreshLabel="Refresh issues"
                    rows={issues}
                    Row={IssueRow}
                />
            </ShowcaseItem>

            <ShowcaseItem
                title="GitHub inbox"
                description="Notifications newest first, opened in the app or handed to the browser."
            >
                <GithubPanel
                    title="Inbox"
                    description="GitHub notifications for the connected account."
                    refreshLabel="Refresh inbox"
                    rows={notifications}
                    Row={InboxRow}
                >
                    <Button
                        slot="actions"
                        variant="outline"
                        size="sm"
                        disabled
                    >
                        Mark all read
                    </Button>
                </GithubPanel>
            </ShowcaseItem>

            <ShowcaseItem
                full
                reveal={false}
                title="Your repositories"
                description="Pinned repositories with stars, forks, and the language mix read from the GitHub API when the site builds."
            >
                <div data-reveal-grid class="grid h-full gap-1 sm:grid-cols-2 xl:grid-cols-4">
                    {
                        repositories.map((repository) => (
                                <RepoCard
                                    repo={repository.repo}
                                    description={repository.description}
                                    stars={repository.stars}
                                    forks={repository.forks}
                                    languages={repository.languages}
                                    avatarSrc={repository.avatarUrl}
                                    avatarInitial={repository.repo.slice(0, 1)}
                                />
                               ))
                    }
                </div>
            </ShowcaseItem>
        </div>
    </div>
</section>
