---
import { getShowcaseRepositories } from "../lib/github";
import GithubPanel from "./github/GithubPanel.astro";
import InboxRow from "./github/InboxRow.astro";
import IssueRow from "./github/IssueRow.astro";
import PullRow from "./github/PullRow.astro";
import ChangesPanel from "./repo/ChangesPanel.astro";
import CommitGraph from "./repo/CommitGraph.astro";
import RepoCard from "./repo/RepoCard.astro";
import ShowcaseItem from "./ShowcaseItem.astro";
import Button from "./ui/Button.astro";
import Frame from "./ui/Frame.astro";
import FramePanel from "./ui/FramePanel.astro";

interface Commit {
    id: string;
    lane: number;
    kind: "commit" | "merge";
    summary: string;
    refs: string[];
    author: string;
    date: string;
    edges: { fromLane: number; toLane: number }[];
}

interface Label {
    name: string;
    color: string;
}

interface Thread {
    title: string;
    number: number;
    author: string;
    date: string;
    labels: Label[];
    status: ThreadStatus;
}

type ThreadStatus =
    | "closed"
    | "completed"
    | "duplicate"
    | "draft"
    | "merged"
    | "notPlanned"
    | "open";

interface Notification {
    type:
        | "CheckSuite"
        | "Commit"
        | "Discussion"
        | "Issue"
        | "PullRequest"
        | "Release";
    title: string;
    meta: string;
    unread?: boolean;
}

