---
import { cn } from "../lib/cn";

interface Props {
    title: string;
    description: string;
    full?: boolean;
    class?: string;
}

const { title, description, full = false, class: className } = Astro.props;
---

<article
    data-reveal
    class={cn(
        "grid h-full grid-rows-[auto_1fr] gap-2",
        full && "lg:col-span-3",
        className
    )}
>
    <div class="flex flex-col">
        <h3 class="font-display text-2xl">{title}</h3>
        <p class="mt-1 max-w-lg text-sm text-muted-foreground text-pretty">
            {description}
        </p>
    </div>
    <div
        class={cn("inert", !full && "flex min-w-0 flex-col")}
        aria-hidden="true"
    >
        <slot />
    </div>
</article>
