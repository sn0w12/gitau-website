---
import {
    Asterisk,
    ChevronRight,
    Copy,
    Dot,
    Plus,
    Repeat2,
    X,
} from "lucide-astro";

import { cn } from "../lib/cn";

type ChangeKind =
    | "added"
    | "conflicted"
    | "copied"
    | "deleted"
    | "modified"
    | "renamed"
    | "typeChanged"
    | "untracked";

interface Props {
    change: ChangeKind;
    class?: string;
}


const CHANGE_COLOR: Record<ChangeKind, string> = {
    added: "text-success",
    conflicted: "text-destructive",
    copied: "text-info",
    deleted: "text-destructive",
    modified: "text-warning",
    renamed: "text-info",
    typeChanged: "text-warning",
    untracked: "text-muted-foreground",
};

const CHANGE_GLYPH = {
    added: Plus,
    conflicted: Asterisk,
    copied: Copy,
    deleted: X,
    modified: Dot,
    renamed: ChevronRight,
    typeChanged: Repeat2,
    untracked: Dot,
} satisfies Record<ChangeKind, unknown>;

const { change, class: className } = Astro.props;

const color = CHANGE_COLOR[change];
const Glyph = CHANGE_GLYPH[change] as typeof Plus;

/* The app renders `Squircle` from lucide-react, which draws the glyph as a
 * child `<svg x y width height>`. Astro components do not forward children,
 * so the outer svg is written out here and the glyph component sits inside it
 * with the same `x={4} y={4} size={16}` box. */
const SQUIRCLE_PATH = "M12 3c7.2 0 9 1.8 9 9s-1.8 9-9 9-9-1.8-9-9 1.8-9 9-9";
---

<svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={cn("size-5 shrink-0", color, className)}
>
    <path d={SQUIRCLE_PATH}></path>
    <Glyph size={16} x={4} y={4} class={color} />
</svg>