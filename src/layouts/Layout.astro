---
import "../styles/global.css";

import geistMono from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import inter from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import kalnia from "@fontsource-variable/kalnia/files/kalnia-latin-wght-normal.woff2?url";
import instrumentSerif from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";

import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "../lib/site";

interface Props {
    title: string;
    description?: string;
    preloadHero?: boolean;
}

const { title, description = SITE_DESCRIPTION, preloadHero = false } =
    Astro.props;

/* `Astro.site` comes from `site` in astro.config.mjs, so the head points at
 * whatever domain is configured without naming one here. Without a configured
 * site there is no canonical origin to claim, so those tags are left out. */
const origin = Astro.site;
const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = origin ? new URL(Astro.url.pathname, origin).href : null;

const OG_IMAGE = "/screenshots/repo-dark.png";
const OG_WIDTH = 1402;
const OG_HEIGHT = 920;
const ogImage = origin ? new URL(OG_IMAGE, origin).href : OG_IMAGE;
const fontPreloads = [inter, instrumentSerif, geistMono];
---

<!doctype html>
<html lang="en" data-preload-hero={preloadHero ? "" : undefined}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        {canonical && <link rel="canonical" href={canonical} />}

        <link rel="icon" href="/favicon-32.png" sizes="32x32" />
        <link rel="icon" href="/icon-192.png" sizes="192x192" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link
            rel="preload"
            as="image"
            href="/icon-192.png"
            type="image/png"
        />

        {
            fontPreloads.map((href) => (
                <link
                    rel="preload"
                    href={href}
                    as="font"
                    type="font/woff2"
                    crossorigin
                />
            ))
        }
        {
            preloadHero && (
                <link
                    rel="preload"
                    href={kalnia}
                    as="font"
                    type="font/woff2"
                    crossorigin
                />
            )
        }

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        {canonical && <meta property="og:url" content={canonical} />}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/webp" />
        <meta property="og:image:width" content={String(OG_WIDTH)} />
        <meta property="og:image:height" content={String(OG_HEIGHT)} />
        <meta property="og:image:alt" content={description} />
        <meta property="og:locale" content="en_US" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta
            name="theme-color"
            content="#ffffff"
            media="(prefers-color-scheme: light)"
        />
        <meta
            name="theme-color"
            content="#0e0e0e"
            media="(prefers-color-scheme: dark)"
        />
        <script is:inline>
            // Runs before paint so a dark-mode visitor never sees a white
            // flash. Mirrors the app's theme-store, which defaults to system.
            (() => {
                const mode = localStorage.getItem("theme") ?? "system";
                const dark =
                    mode === "dark" ||
                    (mode === "system" &&
                        window.matchMedia("(prefers-color-scheme: dark)").matches);
                document.documentElement.classList.toggle("dark", dark);
            })();

            if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                document.documentElement.setAttribute("data-reveal-ready", "");
            }
        </script>
    </head>
    <body
        class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased"
    >
        <Nav />
        <main id="main" class="flex-1">
            <slot />
        </main>
        <Footer />
    </body>

    <script>
        const STAGGER_DELAY = 70;
        const targets = document.querySelectorAll<HTMLElement>(
            '[data-reveal]:not([data-reveal="false"])'
        );

        if (
            targets.length > 0 &&
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            const reveal = (target: HTMLElement): void => {
                target.setAttribute("data-revealed", "");
            };

            const revealWhenVisible = (target: HTMLElement): void => {
                const images = [
                    ...(target instanceof HTMLImageElement
                        ? [target]
                        : target.querySelectorAll("img")),
                ].filter(
                    (image) => getComputedStyle(image).display !== "none"
                );

                reveal(target);
            };

            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (!entry.isIntersecting) continue;

                        revealWhenVisible(entry.target as HTMLElement);
                        observer.unobserve(entry.target);
                    }
                },
                {
                    rootMargin: "0px 0px -10% 0px",
                    threshold: 0.05,
                }
            );

            for (const target of targets) {
                if (target.getBoundingClientRect().top < 0) {
                    revealWhenVisible(target);
                    continue;
                }

                observer.observe(target);
            }

            for (const grid of document.querySelectorAll<HTMLElement>(
                "[data-reveal-grid]"
            )) {
                [...grid.children].forEach((child, index) => {
                    if (
                        child instanceof HTMLElement &&
                        child.matches(
                            '[data-reveal]:not([data-reveal="false"])'
                        )
                    ) {
                        child.style.setProperty(
                            "--reveal-delay",
                            `${(index + 1) * STAGGER_DELAY}ms`
                        );
                    }
                });
            }
        }
    </script>
</html>
