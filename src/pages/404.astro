---
import Button from "../components/ui/Button.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="This page does not exist.">
    <section
        class="shell flex min-h-[60vh] flex-col items-center justify-center py-24 text-center"
    >
        <p class="font-mono text-sm text-muted-foreground">404</p>
        <h1 class="mt-4 font-display text-5xl tracking-tight">
            Page not found
        </h1>
        <p class="mt-4 max-w-md text-muted-foreground text-pretty">
            The page you asked for is not here. It may have moved, or it never
            existed.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <Button href="/">Back home</Button>
            <Button href="/download" variant="outline">Download gitau</Button>
        </div>
    </section>
</Layout>
